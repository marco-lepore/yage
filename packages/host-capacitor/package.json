{
  "name": "@yagejs/host-capacitor",
  "version": "0.12.0",
  "description": "Capacitor host for YAGE: app lifecycle, orientation lock, the Back button and file saves",
  "keywords": [
    "yage",
    "game-engine",
    "2d",
    "typescript",
    "capacitor",
    "mobile",
    "host"
  ],
  "license": "MIT",
  "author": "Marco Lepore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-lepore/yage.git",
    "directory": "packages/host-capacitor"
  },
  "homepage": "https://yage.dev",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./detect": {
      "import": {
        "types": "./dist/detect.d.ts",
        "default": "./dist/detect.js"
      },
      "require": {
        "types": "./dist/detect.d.cts",
        "default": "./dist/detect.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@yagejs/core": "^0.12.0",
    "@yagejs/save": "^0.12.0"
  },
  "peerDependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/screen-orientation": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/screen-orientation": "8.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@yagejs/input": "^0.12.0",
    "@yagejs/renderer": "^0.12.0"
  }
}
