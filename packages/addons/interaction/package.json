{
  "name": "@yagejs-addons/interaction",
  "version": "0.2.0",
  "description": "Proximity-based interaction (\"walk up, see a prompt, press E\") for YAGE — nearest-in-range focus selection and an interact event, headless and input-optional",
  "keywords": [
    "yage",
    "yage-addon",
    "game-engine",
    "2d",
    "typescript",
    "interaction",
    "proximity",
    "prompt"
  ],
  "license": "MIT",
  "author": "Marco Lepore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-lepore/yage.git",
    "directory": "packages/addons/interaction"
  },
  "homepage": "https://yage.dev",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@yagejs/core": ">=0.10.0 <0.11.0",
    "@yagejs/input": ">=0.10.0 <0.11.0"
  },
  "peerDependenciesMeta": {
    "@yagejs/input": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "@yagejs/core": ">=0.10.0",
    "@yagejs/input": ">=0.10.0"
  }
}
