{
  "name": "@yagejs-addons/music",
  "version": "0.1.0",
  "description": "Adaptive songs, musical timing and beat-aligned cues on YAGE audio",
  "keywords": [
    "yage",
    "yage-addon",
    "audio",
    "music",
    "adaptive"
  ],
  "license": "MIT",
  "author": "Marco Lepore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-lepore/yage.git",
    "directory": "packages/addons/music"
  },
  "homepage": "https://yage.dev",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@yagejs/audio": ">=0.13.0 <0.14.0",
    "@yagejs/core": ">=0.13.0 <0.14.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "@yagejs/audio": ">=0.13.0",
    "@yagejs/core": ">=0.13.0"
  }
}
