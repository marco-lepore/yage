{
  "name": "@yagejs-addons/perception",
  "version": "0.1.0",
  "description": "2D sight, occlusion policies, and last-seen memory for YAGE",
  "keywords": [
    "yage",
    "yage-addon",
    "perception",
    "ai",
    "2d"
  ],
  "license": "MIT",
  "author": "Marco Lepore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-lepore/yage.git",
    "directory": "packages/addons/perception"
  },
  "homepage": "https://yage.dev",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./physics": {
      "import": {
        "types": "./dist/physics.d.ts",
        "default": "./dist/physics.js"
      },
      "require": {
        "types": "./dist/physics.d.cts",
        "default": "./dist/physics.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@yagejs/core": ">=0.13.0 <0.14.0",
    "@yagejs/physics": ">=0.13.0 <0.14.0"
  },
  "peerDependenciesMeta": {
    "@yagejs/physics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "@yagejs/core": ">=0.13.0",
    "@yagejs/physics": ">=0.13.0"
  }
}
