{
  "name": "@yagejs-addons/stats",
  "version": "0.0.0",
  "description": "Stats, source-owned modifiers, timed effects, and dependency-checked formulas for YAGE",
  "keywords": [
    "yage",
    "yage-addon",
    "stats",
    "modifiers",
    "buffs",
    "formulas",
    "rpg"
  ],
  "license": "MIT",
  "author": "Marco Lepore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-lepore/yage.git",
    "directory": "packages/addons/stats"
  },
  "homepage": "https://yage.dev",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@yagejs/core": ">=0.11.0 <0.12.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "@yagejs/core": ">=0.11.0"
  }
}
