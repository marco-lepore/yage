{
  "name": "@yagejs-addons/steering",
  "version": "0.4.0",
  "description": "Steering (movement AI) for YAGE — seek, flee, arrive, wander, pursue/evade, obstacle avoidance, and flocking, blended into a desired velocity",
  "keywords": [
    "yage",
    "yage-addon",
    "game-engine",
    "2d",
    "typescript",
    "steering",
    "ai",
    "movement",
    "flocking",
    "boids"
  ],
  "license": "MIT",
  "author": "Marco Lepore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-lepore/yage.git",
    "directory": "packages/addons/steering"
  },
  "homepage": "https://yage.dev",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./physics": {
      "import": {
        "types": "./dist/physics.d.ts",
        "default": "./dist/physics.js"
      },
      "require": {
        "types": "./dist/physics.d.cts",
        "default": "./dist/physics.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@yagejs/core": ">=0.11.0 <0.12.0",
    "@yagejs/physics": ">=0.11.0 <0.12.0"
  },
  "peerDependenciesMeta": {
    "@yagejs/physics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "@yagejs/core": ">=0.11.0",
    "@yagejs/physics": ">=0.11.0"
  }
}
