{
  "name": "@yagejs-addons/sequence",
  "version": "0.0.0",
  "description": "Keyframe sequences for YAGE",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./renderer": {
      "import": {
        "types": "./dist/renderer.d.ts",
        "default": "./dist/renderer.js"
      },
      "require": {
        "types": "./dist/renderer.d.cts",
        "default": "./dist/renderer.cjs"
      }
    },
    "./document": {
      "import": {
        "types": "./dist/document.d.ts",
        "default": "./dist/document.js"
      },
      "require": {
        "types": "./dist/document.d.cts",
        "default": "./dist/document.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@yagejs/core": ">=0.11.0 <0.12.0",
    "@yagejs/renderer": ">=0.11.0 <0.12.0"
  },
  "devDependencies": {
    "@yagejs/core": ">=0.11.0",
    "@yagejs/renderer": ">=0.11.0",
    "@vitest/coverage-v8": "^4.0.18"
  },
  "peerDependenciesMeta": {
    "@yagejs/renderer": {
      "optional": true
    }
  }
}
