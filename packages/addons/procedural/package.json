{
  "name": "@yagejs-addons/procedural",
  "version": "0.1.0",
  "description": "Seeded region graphs, catalog room layouts and cellular caves with progression validation for YAGE",
  "keywords": [
    "yage",
    "yage-addon",
    "procedural",
    "rooms",
    "generation"
  ],
  "license": "MIT",
  "author": "Marco Lepore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-lepore/yage.git",
    "directory": "packages/addons/procedural"
  },
  "homepage": "https://yage.dev",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./level": {
      "import": {
        "types": "./dist/level.d.ts",
        "default": "./dist/level.js"
      },
      "require": {
        "types": "./dist/level.d.cts",
        "default": "./dist/level.cjs"
      }
    },
    "./navigation": {
      "import": {
        "types": "./dist/navigation.d.ts",
        "default": "./dist/navigation.js"
      },
      "require": {
        "types": "./dist/navigation.d.cts",
        "default": "./dist/navigation.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@yagejs/core": ">=0.13.0 <0.14.0",
    "@yagejs/level": ">=0.13.0 <0.14.0",
    "@yagejs/pathfinding": ">=0.13.0 <0.14.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "@yagejs/core": ">=0.13.0",
    "@yagejs/level": ">=0.13.0",
    "@yagejs/pathfinding": ">=0.13.0"
  },
  "peerDependenciesMeta": {
    "@yagejs/level": {
      "optional": true
    },
    "@yagejs/pathfinding": {
      "optional": true
    }
  }
}
