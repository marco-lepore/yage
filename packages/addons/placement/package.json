{
  "name": "@yagejs-addons/placement",
  "version": "0.0.0",
  "description": "Furniture and modular object placement with previews, attachments, validation, editing and layout history for YAGE",
  "keywords": [
    "yage",
    "yage-addon",
    "placement",
    "furniture",
    "building"
  ],
  "license": "MIT",
  "author": "Marco Lepore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-lepore/yage.git",
    "directory": "packages/addons/placement"
  },
  "homepage": "https://yage.dev",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./presenters": {
      "import": {
        "types": "./dist/presenters.d.ts",
        "default": "./dist/presenters.js"
      },
      "require": {
        "types": "./dist/presenters.d.cts",
        "default": "./dist/presenters.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@yagejs/core": ">=0.12.0 <0.13.0",
    "@yagejs/level": ">=0.12.0 <0.13.0",
    "@yagejs/input": ">=0.12.0 <0.13.0",
    "@yagejs/renderer": ">=0.12.0 <0.13.0"
  },
  "devDependencies": {
    "@yagejs/core": ">=0.12.0",
    "@yagejs/level": ">=0.12.0",
    "@yagejs/input": ">=0.12.0",
    "@yagejs/renderer": ">=0.12.0",
    "@vitest/coverage-v8": "^4.0.18"
  },
  "peerDependenciesMeta": {
    "@yagejs/renderer": {
      "optional": true
    }
  }
}
