{
  "name": "@yagejs-tools/lab",
  "version": "0.1.0",
  "description": "Scenario browser for YAGE games — mount entities and scenes in a real engine and tune them with controls",
  "keywords": [
    "yage",
    "yage-tool",
    "game-engine",
    "2d",
    "typescript",
    "scenario",
    "storybook",
    "devtools"
  ],
  "license": "MIT",
  "author": "Marco Lepore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-lepore/yage.git",
    "directory": "packages/tools/lab"
  },
  "homepage": "https://yage.dev",
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "yage-lab": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "import": "./dist/runner.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vitest/expect": "^4.1.0",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "@playwright/test": "^1.60.0",
    "@yagejs/core": ">=0.10.1 <0.11.0",
    "@yagejs/debug": ">=0.10.1 <0.11.0",
    "@yagejs/renderer": ">=0.10.1 <0.11.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "@yagejs/core": ">=0.10.1",
    "@yagejs/debug": ">=0.10.1",
    "@yagejs/renderer": ">=0.10.1",
    "vite": "^8.0.0"
  }
}
