{
  "name": "@yagejs-tools/audio",
  "version": "0.0.0",
  "description": "Build-time instrument rendering and selected WAV banks for YAGE",
  "keywords": [
    "yage",
    "audio",
    "synthesis",
    "build",
    "devtools"
  ],
  "license": "MIT",
  "author": "Marco Lepore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-lepore/yage.git",
    "directory": "packages/tools/audio"
  },
  "homepage": "https://yage.dev",
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "yage-audio": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@yagejs-addons/synth": "^0.3.0"
  },
  "peerDependencies": {
    "@yagejs/audio": ">=0.12.0 <0.13.0",
    "@yagejs/core": ">=0.12.0 <0.13.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@yagejs/audio": ">=0.12.0",
    "@yagejs/core": ">=0.12.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
