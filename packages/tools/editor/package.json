{
  "name": "@yagejs-tools/editor",
  "version": "0.0.0",
  "description": "Level editor for YAGE games — place entities in a real engine and save them as versioned level files",
  "keywords": [
    "yage",
    "yage-tool",
    "game-engine",
    "2d",
    "typescript",
    "level",
    "level-editor",
    "devtools"
  ],
  "license": "MIT",
  "author": "Marco Lepore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-lepore/yage.git",
    "directory": "packages/tools/editor"
  },
  "homepage": "https://yage.dev",
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "yage-editor": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@yagejs/core": ">=0.10.2 <0.11.0",
    "@yagejs/level": ">=0.10.2 <0.11.0",
    "@yagejs/renderer": ">=0.10.2 <0.11.0",
    "pixi.js": "^8.5.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@yagejs/audio": ">=0.10.2",
    "@yagejs/core": ">=0.10.2",
    "@yagejs/level": ">=0.10.2",
    "@yagejs/physics": ">=0.10.2",
    "@yagejs/renderer": ">=0.10.2",
    "happy-dom": "^20.8.9",
    "pixi.js": "^8.5.0",
    "vite": "^8.0.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "dependencies": {
    "picomatch": "^4.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
