{
  "name": "@yagejs-tools/feedback",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "yage-feedback": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p demo/tsconfig.json --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "demo": "vite demo --host 127.0.0.1 --port 5213 --strictPort",
    "lab": "cd demo && node ../../lab/dist/cli.js dev --port 5214 --no-open"
  },
  "peerDependencies": {
    "@yagejs/core": ">=0.11.0 <0.12.0",
    "@yagejs/debug": ">=0.11.0 <0.12.0",
    "@yagejs/input": ">=0.11.0 <0.12.0",
    "@yagejs/renderer": ">=0.11.0 <0.12.0"
  },
  "peerDependenciesMeta": {
    "@yagejs/input": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@yagejs-tools/lab": "^0.2.0",
    "@yagejs/core": ">=0.11.0 <0.12.0",
    "@yagejs/debug": ">=0.11.0 <0.12.0",
    "@yagejs/input": ">=0.11.0 <0.12.0",
    "@yagejs/renderer": ">=0.11.0 <0.12.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
