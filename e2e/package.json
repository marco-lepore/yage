{
  "name": "@yagejs/e2e",
  "private": true,
  "version": "0.0.14",
  "type": "module",
  "scripts": {
    "dev": "vite --config fixtures/vite.config.ts",
    "build": "vite build --config fixtures/vite.config.ts",
    "preview": "vite preview --config fixtures/vite.config.ts",
    "typecheck": "tsc -p specs/tsconfig.json && tsc -p fixtures/src/baseline/tsconfig.json && tsc -p native/tsconfig.json",
    "e2e": "playwright test -c ../playwright.config.ts",
    "native": "playwright test -c native/playwright.config.ts",
    "native:game": "node native/prepare-game.mjs"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "vite": "^8.0.0",
    "@electron/asar": "4.3.1",
    "vite-plugin-wasm": "^3.6.0",
    "pixi.js": "^8.22.0",
    "@yagejs-tools/pack": "^0.1.0"
  },
  "dependencies": {
    "@yagejs-tools/editor": "^0.3.0",
    "@yagejs-addons/abilities": "^0.6.0",
    "@yagejs-addons/steering": "^0.6.0",
    "@yagejs-addons/dialogue": "^0.8.0",
    "@yagejs-addons/inventory": "^0.5.0",
    "@yagejs-addons/loot": "^0.1.0",
    "@yagejs-addons/interaction": "^0.5.0",
    "@yagejs/core": "^0.13.0",
    "@yagejs/debug": "^0.13.0",
    "@yagejs/input": "^0.13.0",
    "@yagejs/level": "^0.13.0",
    "@yagejs/lighting": "^0.13.0",
    "@yagejs/pathfinding": "^0.13.0",
    "@yagejs/physics": "^0.13.0",
    "@yagejs/renderer": "^0.13.0",
    "@yagejs/save": "^0.13.0",
    "@yagejs/ui": "^0.13.0",
    "@yagejs/audio": "^0.13.0",
    "@yagejs/effects": "^0.13.0",
    "@yagejs/host-electron": "^0.13.0",
    "@yagejs/host-capacitor": "^0.13.0"
  }
