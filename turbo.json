{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@yagejs/e2e#build": {
      "dependsOn": ["^build"],
      "outputs": ["fixtures/dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "//#measure": {},
    "lint": {
      "dependsOn": ["//#measure"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@yagejs/docs#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/addons/*/docs/llms/**",
        "$TURBO_ROOT$/packages/tools/*/docs/llms/**"
      ],
      "outputs": [
        "dist/**",
        "public/llms/**",
        "public/llms.txt",
        "public/llms-full.txt"
      ]
    },
    "@yagejs/docs#dev": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
