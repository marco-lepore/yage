{
  "$schema": "https://turbo.build/schema.json",
  // `dev` is persistent in every package, and turbo refuses to start when it
  // has more persistent tasks than slots. The count is one per workspace, so
  // this is raised when a package is added.
  "concurrency": "40",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@yagejs/e2e#build": {
      "dependsOn": ["^build"],
      "outputs": ["fixtures/dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "//#measure": {},
    "lint": {
      "dependsOn": ["//#measure"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "docs#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "docs#dev": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
