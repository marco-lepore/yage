{
  "name": "@yagejs/docs",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/copy-llms.mjs && astro dev",
    "build": "node scripts/copy-llms.mjs && astro build && node scripts/verify-dist.mjs",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc -p tsconfig.demos.json && node scripts/check-snippets.mjs",
    "check:snippets": "node scripts/check-snippets.mjs",
    "preview": "astro preview",
    "clean": "rm -rf dist .astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.38.2",
    "astro": "^6.1.3",
    "sharp": "^0.33.0",
    "starlight-typedoc": "^0.21.5",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "devDependencies": {
    "@yagejs-addons/abilities": "^0.5.0",
    "@yagejs-addons/dialogue": "^0.7.0",
    "@yagejs-addons/feel": "^0.2.0",
    "@yagejs-addons/i18n": "^0.1.0",
    "@yagejs-addons/interaction": "^0.4.0",
    "@yagejs-addons/inventory": "^0.4.0",
    "@yagejs-addons/quests": "^0.4.0",
    "@yagejs-addons/steering": "^0.5.0",
    "@yagejs-addons/synth": "^0.3.0",
    "@yagejs-addons/virtual-controls": "^0.4.0",
    "@yagejs-tools/editor": "^0.2.0",
    "@yagejs-tools/feedback": "^0.1.0",
    "@yagejs-tools/lab": "^0.3.0",
    "@yagejs/audio": "^0.12.0",
    "@yagejs/core": "^0.12.0",
    "@yagejs/debug": "^0.12.0",
    "@yagejs/effects": "^0.12.0",
    "@yagejs/input": "^0.12.0",
    "@yagejs/level": "^0.12.0",
    "@yagejs/lighting": "^0.12.0",
    "@yagejs/particles": "^0.12.0",
    "@yagejs/pathfinding": "^0.12.0",
    "@yagejs/physics": "^0.12.0",
    "@yagejs/renderer": "^0.12.0",
    "@yagejs/save": "^0.12.0",
    "@yagejs/tilemap": "^0.12.0",
    "@yagejs/ui": "^0.12.0",
    "@yagejs/ui-react": "^0.12.0",
